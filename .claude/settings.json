{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(realpath:*)",
      "Bash(cd:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git reflog:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(git fetch:*)",

      "Bash(./mvnw:*)",
      "Bash(service-player/mvnw:*)",
      "Bash(service-commerce/mvnw:*)",

      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm config get:*)",
      "Bash(npx ng:*)",
      "Bash(npx --yes markdownlint-cli:*)",
      "Bash(npx --yes markdownlint-cli2:*)",
      "Bash(npx --no-install:*)",

      "Bash(./scripts/pre-pr-tests.sh:*)",
      "Bash(shellcheck:*)",
      "Bash(yamllint:*)",
      "Bash(markdownlint:*)",
      "Bash(pipx run yamllint:*)",

      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker events:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose exec:*)",

      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Read(./infrastructure/.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "MAVEN_ARGS": "-B --no-transfer-progress"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-irreversible.sh"
          }
        ]
      }
    ]
  }
}
