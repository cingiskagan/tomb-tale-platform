# =============================================
# Tomb Tale Platform — Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Proxy ---
PROXY_HTTP_PUBLISHED_PORT=8080

# --- Keycloak (identity provider) ---
# The origin players reach Keycloak through, which is the proxy. Keycloak puts
# it in every token, so the issuer is this plus /realms/tombtale.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# What both services trust: KEYCLOAK_PUBLIC_URL plus /realms/tombtale. The
# services read it from here (run-local.sh), so the two must agree.
OIDC_ISSUER_URI=http://localhost:8080/realms/tombtale
# The admin console listens here, on localhost only. The proxy never routes /admin.
KEYCLOAK_ADMIN_PORT=8180
# The master realm's first administrator. Keycloak calls it temporary: sign in
# once and create a permanent administrator. Players live in the tombtale realm,
# so this account cannot sign in to the portal.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin_pass

# Where Keycloak sends the portal after login and logout. The realm file reads them.
PORTAL_REDIRECT_URI=http://localhost:4200/callback
PORTAL_POST_LOGOUT_URI=http://localhost:4200/
PORTAL_ORIGIN=http://localhost:4200

# Keycloak's mail: verification links, password resets and the login code.
# Mailpit catches it in dev, at http://localhost:8025. Prod changes only these.
SMTP_HOST=mailpit
SMTP_PORT=1025
# true sends SMTP_USER and SMTP_PASSWORD. Mailpit needs neither.
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SENDER_ADDRESS=no-reply@tombtale.localhost
SMTP_SENDER_NAME=Tomb Tale

# --- Pinned image tags ---
POSTGRES_IMAGE=postgres:17.2-alpine
REDIS_IMAGE=redis:7.4.2-alpine
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.114.0
MAILPIT_IMAGE=axllent/mailpit:v1.31.2

# --- Postgres (shared database) ---
POSTGRES_DB=tombtale_db
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=dev_admin_pass
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=dev_keycloak_pass
POSTGRES_PLAYER_USER=service_player
POSTGRES_PLAYER_PASSWORD=dev_player_pass
POSTGRES_COMMERCE_USER=service_commerce
POSTGRES_COMMERCE_PASSWORD=dev_commerce_pass

# --- MongoDB ---
MONGO_USER=
MONGO_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- Outbox (services that publish events) ---
# Shared by every service. A service that needs its own value points its
# application.yml at its own key, such as PLAYER_OUTBOX_BATCH_SIZE.
OUTBOX_PUBLISH_INTERVAL=PT5S
OUTBOX_BATCH_SIZE=100
# How long one send waits for the RabbitMQ confirm.
OUTBOX_CONFIRM_TIMEOUT=PT5S
# The purge deletes rows published longer ago than the retention.
OUTBOX_RETENTION=P30D
OUTBOX_PURGE_CRON=0 30 3 * * *

# --- Service Ports ---
SERVICE_PLAYER_PORT=8081
SERVICE_COMMERCE_PORT=8082
